<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Points at the server itself, used only to create the database the first time -->
    <add name="MasterConnection"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=master;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
    <!-- Points at the application database -->
    <add name="AppConnection"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ICE2NumbersDb;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
